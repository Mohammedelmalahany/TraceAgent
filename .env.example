# Copy this file to .env and adjust values for your machine.

# Root folder for all data (cloned repos, processed outputs, logs).
# Must be OUTSIDE OneDrive / synced folders.
DATA_DIR=D:/traceagent-data

# Benchmark source (HuggingFace dataset id + split)
DATASET_NAME=princeton-nlp/SWE-bench_Lite
DATASET_SPLIT=test
# Optional local fallback (jsonl), used if HuggingFace is unreachable
LOCAL_DATASET_PATH=

# Preprocessing limits
MAX_FILE_SIZE_KB=1024

# Windows without Developer Mode cannot create symlinks; silence the HF warning
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
